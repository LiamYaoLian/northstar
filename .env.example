# Turso cloud database (recommended — import data/northstar.db via `turso db import`)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js (required in production; dev falls back to a local-only secret)
AUTH_SECRET=
# Optional SMTP for magic-link email (otherwise links are logged to the server console)
EMAIL_SERVER=
EMAIL_FROM=Northstar <no-reply@northstar.local>
# Optional: assign legacy rows without user_id to this email on migration
NORTHSTAR_DEFAULT_USER_EMAIL=

# Optional: OpenAI for task classify (LLM first) and subtask breakdown (rules fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
